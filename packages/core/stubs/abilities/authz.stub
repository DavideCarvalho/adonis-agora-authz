{{{
  exports({ to: app.makePath('app/abilities/authz.ts') })
}}}
import { defineAuthzAbilities } from '@adonis-agora/authz'

/**
 * Bouncer abilities backed by @adonis-agora/authz. Both consult the store, with
 * wildcard matching ("posts.*" covers "posts.edit"):
 *
 *   await ctx.bouncer.allows('can', 'posts.edit', post)
 *   await ctx.bouncer.authorize('hasRole', 'admin')
 *
 * In Edge templates:
 *
 *   @can('can', 'posts.edit')
 *     <a href="...">Edit</a>
 *   @end
 */
export const { can, hasRole } = defineAuthzAbilities()
